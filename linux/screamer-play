#!/bin/sh
# Unified launcher for the Screamer trilogy:
#   Screamer (1995), Screamer 2 (1996), and Screamer Rally (1997).
#
#   screamer-play [1|2|rally]          show the settings window, then start the game
#   screamer-play --play [1|2|rally]   start the game with saved settings (no window)
#   screamer-play stop                 end the game this script started
#   screamer-play status               running or idle
#   screamer-play <anything else>      passed to ScreamerLauncher (--check, --help, ...)
#
# Every launch waits for the game to end; the game runs in its own session,
# recorded in running.pid with its start time, so "stop" ends exactly that
# session (gamescope, the launcher, DOSBox) and never a stale or reused pid.
# The session, GPU choice and gamescope come from the shared rea-play.sh
# library (rea-launcher-sdk); this script holds Screamer's choices.
#
# Optional environment:
#   SCREAMER_LAUNCHER   path to ScreamerLauncher binary
#   SCREAMER_DOSBOX     path to bundled dosbox binary
#   SCREAMER_WAIT       accepted for AppImage compatibility; every launch waits
#   SCREAMER_SCREEN     WIDTHxHEIGHT for "resolution = fullscreen" (default:
#                       the current mode from xrandr, else 1920x1080)
set -u
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=screamer-play

REA_MODE=native
REA_APP=screamer-launcher
REA_EXE_NAME=ScreamerLauncher
REA_EXE_HINT=SCREAMER_LAUNCHER
REA_EXE=${SCREAMER_LAUNCHER:-}
REA_EXE_SEARCH="../target/release/ScreamerLauncher ../target/debug/ScreamerLauncher"
REA_STATE_BASE=${XDG_CONFIG_HOME:-$HOME/.config}
REA_WAIT=${SCREAMER_WAIT:-}
# gamescope: -w/-h only; the race size from "resolution" ("fullscreen" is the
# screen's size, "original" and anything malformed 1920x1080); fsr is the
# template's and the settings window's default scaler.
REA_GAMESCOPE_OUTPUT=0
REA_DEFAULT_SCALER=fsr
REA_FULLSCREEN_SIZE=screen
REA_SCREEN=${SCREAMER_SCREEN:-}
# DOSBox finds the pads itself; no SDL variables are added.
REA_SDL_ENV=

rea_hook_command() {
  case "${1:-}" in
    --play|start|status|stop) return 127 ;;   # the helper's own commands
    1|2|3|s1|s2|sr|screamer|screamer1|screamer2|rally|screamer-rally)
      # The window (with that game selected), then the game; never back to
      # the library's own commands, whatever the game's exit status.
      rea_cmd_default "$@"
      exit ;;
    *)
      # Anything else goes to the launcher itself (--check, --controllers, ...).
      rea_require_exe || exit 1
      exec "$REA_EXE" "$@" ;;
  esac
}

rea_init || exit 1
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
