diff --git a/contrib/resources/glshaders/interpolation/fsr.glsl b/contrib/resources/glshaders/interpolation/fsr.glsl
new file mode 100644
index 0000000..648cc15
--- /dev/null
+++ b/contrib/resources/glshaders/interpolation/fsr.glsl
@@ -0,0 +1,220 @@
+#version 120
+
+/*
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ *  AMD FidelityFX Super Resolution 1.0 (EASU + RCAS) +
+ *  Bidirectional Optical-Flow Frame Generation for DOSBox Staging.
+ *
+ *  Stage 1: Optional Bidirectional Optical-Flow Frame Generation
+ *           (when rubyFrameBlend > 0.0, synthesizes the motion-compensated
+ *           midpoint frame between rubyPrevTexture and rubyTexture while
+ *           protecting static HUD/UI elements).
+ *  Stage 2: EASU (Edge-Adaptive Spatial Upsampling) — 12-tap directional
+ *           anisotropic Lanczos2 kernel with anti-ringing neighborhood clamp.
+ *  Stage 3: RCAS (Robust Contrast-Adaptive Sharpening) — 5-tap local
+ *           contrast-bounded sharpening pass.
+ */
+
+#pragma use_npot_texture
+#pragma use_srgb_texture
+#pragma use_srgb_framebuffer
+#pragma force_single_scan
+#pragma force_no_pixel_doubling
+
+uniform vec2 rubyTextureSize;
+uniform vec2 rubyInputSize;
+uniform vec2 rubyOutputSize;
+
+varying vec2 v_texCoord;
+
+#if defined(VERTEX)
+
+attribute vec4 a_position;
+
+void main()
+{
+	gl_Position = a_position;
+	v_texCoord  = vec2(a_position.x + 1.0, 1.0 - a_position.y) * 0.5 *
+	              rubyInputSize / rubyTextureSize;
+}
+
+#elif defined(FRAGMENT)
+
+uniform sampler2D rubyTexture;
+uniform sampler2D rubyPrevTexture;
+uniform float rubyFrameBlend;
+
+float luma(vec3 c)
+{
+	return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+// Stage 1: Bidirectional Optical-Flow Frame Generation sample at texel UV
+vec3 sampleFrame(vec2 uv)
+{
+	vec2 max_uv = (rubyInputSize - vec2(0.5)) / rubyTextureSize;
+	vec2 clamped_uv = clamp(uv, vec2(0.5) / rubyTextureSize, max_uv);
+	vec3 curr = texture2D(rubyTexture, clamped_uv).rgb;
+
+	if (rubyFrameBlend <= 0.001) {
+		return curr;
+	}
+
+	vec3 prev = texture2D(rubyPrevTexture, clamped_uv).rgb;
+	float l_curr = luma(curr);
+	float l_prev = luma(prev);
+	float diff0 = abs(l_curr - l_prev);
+
+	// Static pixel / HUD / menu protection: if luminance barely changed,
+	// keep exact current pixel to prevent any HUD ghosting.
+	if (diff0 < 0.015) {
+		return curr;
+	}
+
+	vec2 inv_tex = 1.0 / rubyTextureSize;
+	vec2 best_v = vec2(0.0);
+	float best_err = diff0;
+
+	// Bidirectional motion search across horizontal, vertical, and diagonal candidates
+	for (int dy = -2; dy <= 2; ++dy) {
+		for (int dx = -3; dx <= 3; ++dx) {
+			vec2 v = vec2(float(dx) * 1.5, float(dy) * 1.25) * inv_tex;
+			vec2 uv_f = clamp(clamped_uv + 0.5 * v, vec2(0.5) * inv_tex, max_uv);
+			vec2 uv_b = clamp(clamped_uv - 0.5 * v, vec2(0.5) * inv_tex, max_uv);
+			float lf = luma(texture2D(rubyTexture, uv_f).rgb);
+			float lb = luma(texture2D(rubyPrevTexture, uv_b).rgb);
+			float penalty = 0.008 * (abs(float(dx)) + abs(float(dy)));
+			float err = abs(lf - lb) + penalty;
+			if (err < best_err) {
+				best_err = err;
+				best_v = v;
+			}
+		}
+	}
+
+	vec2 uv_curr = clamp(clamped_uv + 0.5 * best_v, vec2(0.5) * inv_tex, max_uv);
+	vec2 uv_prev = clamp(clamped_uv - 0.5 * best_v, vec2(0.5) * inv_tex, max_uv);
+	vec3 c_f = texture2D(rubyTexture, uv_curr).rgb;
+	vec3 c_b = texture2D(rubyPrevTexture, uv_prev).rgb;
+
+	// Disocclusion confidence: fall back smoothly to current frame if photometric
+	// residual indicates an Newly uncovered background / fast edge.
+	float match_err = abs(luma(c_f) - luma(c_b));
+	float confidence = 1.0 - smoothstep(0.04, 0.22, match_err);
+	vec3 warped = mix(c_f, c_b, rubyFrameBlend);
+	return mix(curr, warped, confidence);
+}
+
+// Anisotropic Lanczos2 weight helper for FSR 1.0 EASU
+float easuWeight(vec2 d, vec2 dir, vec2 len2)
+{
+	vec2 rot = vec2(
+		d.x * dir.x + d.y * dir.y,
+		d.x * (-dir.y) + d.y * dir.x
+	);
+	rot *= len2;
+	float x2 = clamp(dot(rot, rot), 0.0, 4.0);
+	// Windowed Lanczos2 polynomial approximation (FSR 1.0)
+	float wB = 0.4 * x2 - 1.0;
+	float wA = x2 * 0.25 - 1.0;
+	wB *= wB;
+	wA *= wA;
+	return (1.5625 * wB - 0.5625) * wA;
+}
+
+// Stage 2: FSR 1.0 EASU (Edge-Adaptive Spatial Upsampling) at texel coordinate p
+vec3 fsrEasu(vec2 p)
+{
+	vec2 inv_tex = 1.0 / rubyTextureSize;
+	vec2 fp = floor(p);
+	vec2 pp = p - fp;
+
+	// Fetch 12-tap cross neighborhood around fp:
+	//       [b] [c]
+	//   [e] [f] [g] [h]
+	//   [i] [j] [k] [l]
+	//       [n] [o]
+	vec2 base = (fp + vec2(0.5)) * inv_tex;
+	vec3 b = sampleFrame(base + vec2( 0.0, -1.0) * inv_tex);
+	vec3 c = sampleFrame(base + vec2( 1.0, -1.0) * inv_tex);
+	vec3 e = sampleFrame(base + vec2(-1.0,  0.0) * inv_tex);
+	vec3 f = sampleFrame(base + vec2( 0.0,  0.0) * inv_tex);
+	vec3 g = sampleFrame(base + vec2( 1.0,  0.0) * inv_tex);
+	vec3 h = sampleFrame(base + vec2( 2.0,  0.0) * inv_tex);
+	vec3 i = sampleFrame(base + vec2(-1.0,  1.0) * inv_tex);
+	vec3 j = sampleFrame(base + vec2( 0.0,  1.0) * inv_tex);
+	vec3 k = sampleFrame(base + vec2( 1.0,  1.0) * inv_tex);
+	vec3 l = sampleFrame(base + vec2( 2.0,  1.0) * inv_tex);
+	vec3 n = sampleFrame(base + vec2( 0.0,  2.0) * inv_tex);
+	vec3 o = sampleFrame(base + vec2( 1.0,  2.0) * inv_tex);
+
+	float lb = luma(b), lc = luma(c);
+	float le = luma(e), lf = luma(f), lg = luma(g), lh = luma(h);
+	float li = luma(i), lj = luma(j), lk = luma(k), ll = luma(l);
+	float ln = luma(n), lo = luma(o);
+
+	// Bilinear-weighted directional gradient accumulation
+	float gx = (lg - le) * (1.0 - pp.x) * (1.0 - pp.y) +
+	           (lh - lf) * pp.x         * (1.0 - pp.y) +
+	           (lk - li) * (1.0 - pp.x) * pp.y +
+	           (ll - lj) * pp.x         * pp.y;
+	float gy = (lj - lb) * (1.0 - pp.x) * (1.0 - pp.y) +
+	           (lk - lc) * pp.x         * (1.0 - pp.y) +
+	           (ln - lf) * (1.0 - pp.x) * pp.y +
+	           (lo - lg) * pp.x         * pp.y;
+
+	float grad_len = sqrt(gx * gx + gy * gy);
+	vec2 dir = (grad_len > 1e-4) ? vec2(gx, gy) / grad_len : vec2(1.0, 0.0);
+	float edge_aniso = clamp(grad_len * 3.5, 0.0, 1.0);
+	vec2 len2 = vec2(1.0 + edge_aniso * 0.5, 1.0 - edge_aniso * 0.35);
+
+	float wb = easuWeight(vec2( 0.0, -1.0) - pp, dir, len2);
+	float wc = easuWeight(vec2( 1.0, -1.0) - pp, dir, len2);
+	float we = easuWeight(vec2(-1.0,  0.0) - pp, dir, len2);
+	float wf = easuWeight(vec2( 0.0,  0.0) - pp, dir, len2);
+	float wg = easuWeight(vec2( 1.0,  0.0) - pp, dir, len2);
+	float wh = easuWeight(vec2( 2.0,  0.0) - pp, dir, len2);
+	float wi = easuWeight(vec2(-1.0,  1.0) - pp, dir, len2);
+	float wj = easuWeight(vec2( 0.0,  1.0) - pp, dir, len2);
+	float wk = easuWeight(vec2( 1.0,  1.0) - pp, dir, len2);
+	float wl = easuWeight(vec2( 2.0,  1.0) - pp, dir, len2);
+	float wn = easuWeight(vec2( 0.0,  2.0) - pp, dir, len2);
+	float wo = easuWeight(vec2( 1.0,  2.0) - pp, dir, len2);
+
+	vec3 sum_c = b * wb + c * wc + e * we + f * wf + g * wg + h * wh +
+	             i * wi + j * wj + k * wk + l * wl + n * wn + o * wo;
+	float sum_w = wb + wc + we + wf + wg + wh + wi + wj + wk + wl + wn + wo;
+	vec3 color = sum_c / max(sum_w, 1e-4);
+
+	// Anti-ringing clamp to inner 2x2 neighborhood min/max
+	vec3 min4 = min(min(f, g), min(j, k));
+	vec3 max4 = max(max(f, g), max(j, k));
+	return clamp(color, min4, max4);
+}
+
+void main()
+{
+	vec2 p = v_texCoord * rubyTextureSize - vec2(0.5);
+	vec3 c = fsrEasu(p);
+
+	// Stage 3: FSR 1.0 RCAS (Robust Contrast-Adaptive Sharpening)
+	vec2 step_p = rubyInputSize / max(rubyOutputSize, rubyInputSize);
+	vec3 n = fsrEasu(p + vec2( 0.0, -step_p.y));
+	vec3 s = fsrEasu(p + vec2( 0.0,  step_p.y));
+	vec3 w = fsrEasu(p + vec2(-step_p.x,  0.0));
+	vec3 e = fsrEasu(p + vec2( step_p.x,  0.0));
+
+	vec3 min4 = min(min(n, s), min(w, e));
+	vec3 max4 = max(max(n, s), max(w, e));
+	float l_min = min(luma(min4), luma(c));
+	float l_max = max(luma(max4), luma(c));
+	float contrast = l_max - l_min;
+
+	// Contrast-adaptive negative lobe weight (bounded to prevent clipping)
+	float lobe = -0.18 * (1.0 - smoothstep(0.15, 0.65, contrast));
+	vec3 rcas = (c + lobe * (n + s + w + e)) / (1.0 + 4.0 * lobe);
+	gl_FragColor = vec4(clamp(rcas, 0.0, 1.0), 1.0);
+}
+
+#endif
