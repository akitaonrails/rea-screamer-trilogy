#!/bin/sh
# The AppImage entry: bundled dosbox-staging first on the PATH, then
# screamer-play (the settings window, then the game in gamescope when installed).
HERE=$(dirname "$(readlink -f "$0")")
export PATH="$HERE/usr/lib/dosbox-staging:$HERE/usr/lib/screamer:$PATH"
export SCREAMER_LAUNCHER="$HERE/usr/lib/screamer/ScreamerLauncher"
export SCREAMER_HOOKS_LIB="$HERE/usr/lib/screamer/libscreamer_hooks.so"
if [ -x "$HERE/usr/lib/dosbox-staging/dosbox" ]; then
  export SCREAMER_DOSBOX="$HERE/usr/lib/dosbox-staging/dosbox"
fi
export SCREAMER_WAIT=1
exec "$HERE/usr/lib/screamer/screamer-play" "$@"
